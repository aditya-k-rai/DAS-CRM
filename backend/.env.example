# Database Connections (Replace [YOUR-PASSWORD] with your actual Supabase DB password)
# Supabase Transaction Pooler URL (Port 6543)
DATABASE_URL="postgresql://postgres.oypmlpsjenwdniakeuqn:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct / Session Pooler Connection URL (Port 5432)
DIRECT_URL="postgresql://postgres.oypmlpsjenwdniakeuqn:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Optional: Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Application Settings
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# S3-Compatible Storage (MinIO in Dev)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="crm-files"
S3_REGION="us-east-1"

# Optional: OpenAI API Integration
OPENAI_API_KEY=""

# Optional: Email Delivery (SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@yourcrm.com"
